# Copy this file to .env and fill in the values:
# cp .env.example .env

# PostgreSQL
# Consumed by Docker Compose to provision the database container.
POSTGRES_USER=microblog
POSTGRES_PASSWORD=pwd-change-me
POSTGRES_DB=microblog

# Connection strings used by the app
# Must match the Postgres credentials above.
DATABASE_URL=postgres://microblog:pwd-change-me@localhost:5432/microblog
REDIS_URL=redis://localhost:6379
